backend/**/.installed.cfg
backend/**/*.egg
backend/**/MANIFEST

# ---------- VIRTUAL ENVIRONMENTS ----------
backend/**/venv
backend/**/.venv
backend/**/env
backend/**/ENV
backend/**/env.bak
backend/**/venv.bak
backend/**/.conda

