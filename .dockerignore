backend/**/start.bat
backend/**/run.ps1
backend/**/run.bat
backend/**/dev.sh
backend/**/dev.ps1

# ---------- CACHE DIVERSO ----------
backend/**/.cache
backend/**/.pytest_cache
backend/**/*.pyc
backend/**/.cpython-*

