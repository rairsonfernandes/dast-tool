backend/**/*.backup
backend/**/*.bak

# ---------- LOGS ----------
backend/**/*.log
backend/**/logs
backend/**/log
backend/**/*.log.*

# ---------- UPLOADS / TEMP ----------
backend/**/uploads
backend/**/tmp
backend/**/temp
backend/**/*.tmp
backend/**/*.swp
backend/**/*.swo
backend/**/*~

# ---------- VERCEL ----------
backend/**/.vercel
backend/**/.vercelignore

# ---------- IDE ----------
backend/**/.vscode
backend/**/.idea
backend/**/*.iml
backend/**/*.ipr
backend/**/*.iws
backend/**/.project
backend/**/.classpath
backend/**/.settings
