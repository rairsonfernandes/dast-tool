backend/**/.webassets-cache
backend/**/flask_session
backend/**/.flaskenv

# ---------- BASE DE DADOS LOCAL ----------
backend/**/*.db
backend/**/*.sqlite
backend/**/*.sqlite3
backend/**/*.db-journal
backend/**/*.db-wal
backend/**/*.db-shm
backend/**/database
backend/**/data
