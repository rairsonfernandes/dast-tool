# flyctl launch added from .gitignore
# ============================================
# SENTINEL — Git Ignore
# ============================================

# --- Ambiente e Segredos (CRÍTICO) ---
**/.env
**/.env.local
**/.env.production
**/.env.*
!**/.env.example

# --- Python / Backend ---
**/__pycache__
**/*.py[cod]
**/*$py.class
**/venv
**/.venv
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-shm
**/*.db-wal
**/sentinel.db*

# --- Node / Frontend ---
**/node_modules
**/dist
**/.vite
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# --- Logs ---
**/*.log
**/logs
**/sentinel-access.log
**/sentinel-error.log

# --- Sistema Operativo / Editor ---
**/.DS_Store
**/Thumbs.db
**/.vscode
**/.idea
**/*.swp
**/*.bak
# Build artifacts
**/*.tsbuildinfo
**/vite.config.js
**/vite.config.d.ts

# Backups
**/pages_backup

# V�deo grande
**/frontend/public/video/demo.mp4

# flyctl launch added from backend/.gitignore
# ============================================================
# SENTINEL BACKEND — .gitignore
# Python · Flask · Vercel · Secrets · SQLite · IDE · OS
# ============================================================

# ---------- ENV / SECRETS ----------
backend/**/.env
backend/**/.env.*
!backend/**/.env.example
backend/**/*.pem
backend/**/*.key
backend/**/*.crt
backend/**/*.p12
backend/**/secrets.json
backend/**/credentials.json

# ---------- PYTHON ----------
