# ============================================
# SENTINEL — Backend Environment Variables
# ============================================
# Copia este ficheiro para `.env` e preenche os valores.
# NUNCA committas o `.env` real.

FLASK_ENV=development
PORT=5000

# Gera com: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=troca-esta-chave-por-uma-segura
JWT_SECRET=troca-esta-chave-por-uma-segura

# Base de Dados (SQLite local ou PostgreSQL)
# DATABASE_URL=sqlite:///sentinel.db
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Frontend (CORS)
CORS_ORIGINS=http://localhost:5173

# Outras integrações (OAuth, etc.)
GOOGLE_CLIENT_ID=teu-google-client-id
GOOGLE_CLIENT_SECRET=teu-google-client-secret
GITHUB_CLIENT_ID=teu-github-client-id
GITHUB_CLIENT_SECRET=teu-github-client-secret